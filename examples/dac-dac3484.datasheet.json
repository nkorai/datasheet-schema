{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "DAC3484",
    "manufacturer": "Texas Instruments",
    "family": "dac",
    "description": "16-bit, 1.25-GSPS, quad-channel current-steering digital-to-analog converter (sub_type: current_steering). Four 16-bit DAC cores with complementary current outputs, on-chip 2x/4x/8x interpolation, complex mixer/QMC, inverse-sinc, and an integer-N clock-multiplying PLL. Double-data-rate LVDS parallel input bus (D[15:0]P/N with DATACLKP/N, FRAMEP/N, PARITYP/N; 1250-MSPS interleaved, 312.5-MSPS per-channel data rate) and multi-device synchronization via OSTRP/N. Pinout (88-pin 9x9 mm WQFN, RKD): complementary current outputs IOUTAP/N, IOUTBP/N, IOUTCP/N, IOUTDP/N (differential, measured across IOUTP/N with 25 ohm each to GND); differential DAC sampling clock DACCLKP/N; output-strobe sync OSTRP/N; LVDS data bus D[15:0]P/N with DATACLKP/N, FRAMEP/N, PARITYP/N, SYNCP/N; BIASJ full-scale-current set (external RSET); EXTIO/VREF 1.2-V reference I/O; PLL loop-filter LPF; CMOS SPI control SCLK/SDIO/SDO/SDENB plus ALARM, SLEEP, RESETB, TXENABLE, TESTMODE; supplies AVDD and PLLAVDD (3.3 V), DIGVDD (1.2 V), CLKVDD and DACVDD (1.2 V), IOVDD (3.3 V) and GND.",
    "package": "WQFN-88 (RKD)",
    "pinCount": 88,
    "polarity": "positive",
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      {
        "orderCode": "DAC3484IRKDT",
