    "mpn": "L980P010",
    "manufacturer": "Thorlabs",
    "family": "laser_diode",
    "description": "980 nm, 10 mW single-transverse-mode Fabry-Perot edge-emitting laser diode in a Ø5.6 mm TO-18 (TO can) 3-pin package with an integrated back-facet monitor photodiode. Center wavelength 970-990 nm, differential slope efficiency 0.5-0.8 W/A, astigmatic edge-emitter beam (parallel/perpendicular far-field divergence 13 deg / 30 deg typ). Compatible with Thorlabs laser-diode and TEC controllers and collimation optics. Pin Code A: pin 1 monitor-diode anode, pin 2 case common, pin 3 laser cathode.",
    "package": "Ø5.6 mm TO-18 (TO can), 3-pin",
    "pinCount": 3,
    "lifecycle": "active",
    "temperatureGrade": "-10..50",
    "orderingVariants": [
      { "orderCode": "L980P010", "package": "Ø5.6 mm TO-18 (TO can), 3-pin" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "PD", "function": "PD_ANODE", "type": "passive", "description": "Monitor photodiode anode. The back-facet monitor PD's anode; sourced photocurrent tracks laser output power for servo control (its cathode is internally common to the case).", "sourcePage": 2 },
    { "number": 2, "name": "CASE", "function": "CASE", "type": "passive", "description": "Case common. The metal TO can, internally common to the laser-diode anode and the monitor-photodiode cathode (Pin Code A).", "sourcePage": 2 },
    { "number": 3, "name": "LD", "function": "LD_CATHODE", "type": "passive", "description": "Laser-diode cathode. Drive current returns here; the laser anode is internally tied to the case common (pin 2).", "sourcePage": 2 }
  ],
