  "component": {
    "mpn": "2N5460",
    "manufacturer": "onsemi",
    "family": "jfet",
    "description": "General-purpose P-channel depletion-mode junction FET for audio and low-frequency small-signal amplifier applications. P-channel counterpart of the 2N5457 family: its defining specs are the zero-gate-voltage drain (saturation) current IDSS (printed -1.0 to -5.0 mA; magnitude stored) and the gate-source cutoff voltage VGS(off) (printed positive on a P-channel part, 0.75 to 6.0 V). JEDEC-registered part in the 2N5460/61/62 family; this document describes the 2N5460 grade. On a P-channel JFET the gate is reverse-biased with a POSITIVE gate-source voltage and drain current flows out of the drain, so the datasheet prints negative IDSS; magnitudes are stored and the sign convention is noted in conditionsVerbatim.",
    "package": "TO-92",
    "pinCount": 3,
    "polarity": "negative",
    "lifecycle": "active",
    "temperatureGrade": "-65..135",
    "orderingVariants": [
      { "orderCode": "2N5460" },
      { "orderCode": "2N5460G" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "Source", "function": "S", "type": "passive", "description": "Source. Source and drain are electrically interchangeable in this symmetric JFET; keep the datasheet labeling (TO-92, Case 29, Style 7).", "sourcePage": 1 },
    { "number": 2, "name": "Drain", "function": "D", "type": "passive", "description": "Drain. Interchangeable with the source.", "sourcePage": 1 },
    { "number": 3, "name": "Gate", "function": "G", "type": "passive", "description": "Gate. Reverse-biased p-n junction control terminal; on this P-channel part it is biased positive relative to the source.", "sourcePage": 1 }
