  "schemaVersion": "1.0",
  "component": {
    "mpn": "LTC2378-20",
    "manufacturer": "Analog Devices",
    "family": "adc",
    "description": "20-bit, 1-Msps, low-noise, fully-differential successive-approximation (SAR) ADC with no pipeline latency (each conversion is independent). sub_type: sar. Fully-differential +/-VREF input (differential full-scale span 2 x VREF). Linearity and DC-accuracy specifications are printed natively in ppm of full-scale rather than LSB. Pinout (16-lead MSOP): analog inputs IN+ / IN-; external reference REF; analog supply VDD; digital I/O supply OVDD; GND; convert-start CNV; BUSY status; serial-clock SCK; serial-data-out SDO; RDL/SDI read-low / chain data-in; CHAIN mode select.",
    "package": "MSOP-16",
    "pinCount": 16,
    "polarity": "bipolar",
    "lifecycle": "active",
    "temperatureGrade": "-40..125"
  },
