    "mpn": "V25-850C1",
    "manufacturer": "VI Systems",
    "family": "laser_diode",
    "description": "850 nm 25 Gbit/s top-emitting datacom VCSEL, bare die. A single-emitter (1x1) GaAs-based vertical-cavity surface-emitting laser chip for short-reach optical interconnects, active optical cables (AOC), and 25G/100G Ethernet. Contacted on the top surface via ground-source microprobe, wire bond, or flip-chip bond; no back-facet monitor photodiode. Symmetric round beam (20 deg FWHM divergence), 19 GHz f3dB modulation bandwidth, and RMS-specified spectral width - the datacom VCSEL parameter set. Siblings V25-850C4 (1x4) and V25-850C12 (1x12) are distinct multi-emitter array products, not covered here.",
    "package": "Bare die, 1x1 VCSEL chip (top-emitting), ~210-250 x 210-250 x 140-160 um",
    "pinCount": 2,
    "polarity": "positive",
    "lifecycle": "active",
    "temperatureGrade": "0..85",
    "orderingVariants": [
      { "orderCode": "V25-850C1", "package": "1x1 single-emitter VCSEL chip, bare die" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "ANODE", "function": "LD_ANODE", "type": "passive", "description": "Laser p-contact (anode, +), on the top surface of the die. Forward drive current flows in here; contacted by ground-source microprobe, wire bond, or flip-chip bump.", "sourcePage": 1 },
    { "number": 2, "name": "CATHODE", "function": "LD_CATHODE", "type": "passive", "description": "Laser n-contact (cathode, -), the substrate / bottom side of the die. No back-facet monitor photodiode is present.", "sourcePage": 1 }
