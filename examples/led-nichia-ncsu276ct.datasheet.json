    "mpn": "NCSU276CT",
    "manufacturer": "Nichia Corporation",
    "family": "led",
    "description": "UV-A (365 nm) ultraviolet LED in a 3.5 x 3.5 mm ceramic SMD package with a silicone-resin lens and Au-plated backside electrodes (anode + cathode). Radiometric emitter: optical output is specified as radiant flux (Phi_e) in watts, per CIE 127:2007, not photometrically. Built-in ESD protection device, Pb-free reflow soldering, RoHS compliant. This document is the U365 peak-wavelength rank (360-370 nm). Forward-voltage ranks (L1..H2, 3.2-4.4 V) and radiant-flux ranks (P6d22..P8d21, 870-1230 mW) ship mixed within one orderable part, the combination ratio decided by Nichia.",
    "package": "Ceramic SMD, 3.5x3.5mm, silicone-resin lens (backside electrodes)",
    "pinCount": 2,
    "lifecycle": "active",
    "temperatureGrade": "-10..85",
    "orderingVariants": [
      { "orderCode": "NCSU276CT-E", "package": "Ceramic SMD, 3.5x3.5mm, silicone lens", "packing": "Embossed carrier tape and reel, 3500 pcs/reel (phi330 mm), JIS C 0806" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "Anode", "function": "ANODE", "type": "passive", "description": "Anode. Backside Au-plated electrode; solder connection is not visible by normal visual inspection.", "sourcePage": 4 },
