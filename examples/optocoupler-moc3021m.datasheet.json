  "component": {
    "mpn": "MOC3021M",
    "manufacturer": "onsemi (Fairchild Semiconductor)",
    "family": "optocoupler",
    "description": "6-pin DIP random-phase photo-triac-driver optocoupler. A GaAs infrared emitting diode is optically coupled to a light-activated silicon bilateral switch (functions like a triac) across the isolation barrier, and is intended to trigger a larger external power triac for 115/240 VAC resistive and inductive loads - it is a TRIGGER device only and must not drive a load directly. 400 V peak blocking voltage (MOC302XM group), IFT max 15 mA (the MOC3021M/MOC3010M grade), UL1577 4170 VACRMS isolation, DIN EN/IEC 60747-5-5 rated. Part of the MOC3010M/MOC3011M/MOC3012M/MOC3020M/MOC3021M/MOC3022M/MOC3023M family; only MOC3021M's IFT grade (15 mA) is emitted here.",
    "package": "6-Pin DIP",
    "pinCount": 6,
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
