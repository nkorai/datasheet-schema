{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "MICROFC-60035-SMT",
    "manufacturer": "onsemi",
    "family": "photodiode",
    "description": "Silicon photomultiplier (SiPM), SensL C-Series, 6 x 6 mm active area with 18980 microcells at a 35 um pitch, in a 4-side tileable surface-mount (SMT) package. A Geiger-mode, single-photon-sensitive, blue-sensitive detector (peak 420 nm) with ~3e6 avalanche gain, a fast-timing output (1 ns rise time), and three terminals: anode, cathode, and a capacitively-coupled fast output. Breakdown voltage ~24.2-24.7 V, operated at 1.0-5.0 V overvoltage above Vbr; performance quoted at 2.5 V overvoltage and 21 degC unless noted.",
    "package": "4-side tileable surface-mount (SMT / SMD), 7 x 7 mm",
    "pinCount": 5,
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "MICROFC-60035-SMT-TR1", "package": "SMT, tape" },
      { "orderCode": "MICROFC-60035-SMT-TR", "package": "SMT, tape and reel (MOQ 3000)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "ANODE", "function": "ANODE", "type": "passive", "description": "SiPM anode (standard output). All microcell anodes are summed to this terminal; the standard anode-cathode readout is taken here.", "sourcePage": 10 },
    { "number": 2, "name": "FAST", "function": "FAST", "type": "passive", "description": "Fast output. Capacitively coupled tap off each microcell for ultrafast timing (1 ns rise time, 3.2 ns FWHM pulse width on the 6 mm sensor).", "sourcePage": 10 },
    { "number": 3, "name": "CATHODE", "function": "CATHODE", "type": "passive", "description": "SiPM cathode. Positive bias (Vbr + overvoltage) is applied here relative to the anode.", "sourcePage": 10 },
    { "number": 4, "name": "NC", "function": "NC", "type": "passive", "description": "No Connect. Should be soldered to the PCB; may be tied to ground or left floating without affecting dark noise.", "sourcePage": 10 },
    { "number": 5, "name": "NC", "function": "NC", "type": "passive", "description": "No Connect (paddle). Recommended to be left floating (not soldered) to achieve optimal soldering on pins 1-4.", "sourcePage": 10 }
  ],
