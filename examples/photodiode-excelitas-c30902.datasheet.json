{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "C30902EH",
    "manufacturer": "Excelitas Technologies",
    "family": "photodiode",
    "description": "Silicon reach-through avalanche photodiode (APD) in a hermetic flat-glass TO-18 package, 500 um circular active area, 400-1100 nm spectral response. A double-diffused reach-through structure for low-light detection at typical avalanche gains larger than 100; recommended operating gain M = 150, at which it delivers 70-80 A/W responsivity, ~800 MHz bandwidth, and a 1.23 fW/sqrt(Hz) noise-equivalent power. Each unit is factory-tested and shipped with its own operating voltage VOP (below the 185-260 V breakdown) that yields M = 150 at 22 degC. Anode (-) and cathode (+) leads; the cathode is reverse-biased positive. All specifications at TA = 22 degC, lambda = 800 nm, M = 150 unless noted.",
    "package": "TO-18 (hermetic, flat glass window)",
    "pinCount": 2,
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "C30902EH", "package": "TO-18, flat glass window" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "ANODE", "function": "ANODE", "type": "passive", "description": "APD anode, marked ANODE (-) on the package outline. The negative bias terminal; the photocurrent return.", "sourcePage": 5 },
    { "number": 2, "name": "CATHODE", "function": "CATHODE", "type": "passive", "description": "APD cathode, marked CATHODE (+) on the package outline. Reverse-biased positive to the per-device operating voltage VOP (below breakdown) that sets M = 150.", "sourcePage": 5 }
  ],
