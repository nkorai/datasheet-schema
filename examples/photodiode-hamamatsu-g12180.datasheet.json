    "mpn": "G12180-010A",
    "manufacturer": "Hamamatsu",
    "family": "photodiode",
    "description": "InGaAs PIN photodiode for telecom NIR (0.9-1.7 um), Ø1 mm circular photosensitive area, in a non-cooled TO-18 can with a borosilicate-glass anti-reflective window optimized for a 1.55 um peak. Peak responsivity ~1.1 A/W at 1.55 um (~0.9 A/W at 1.3 um), large shunt resistance (25-125 MOhm) for low-noise photovoltaic operation, low dark current (0.8 nA typ), and low noise-equivalent power (1.4e-14 W/sqrtHz typ). Targets laser monitors, optical power meters, and optical communications.",
    "package": "TO-18 (Ø9.2 mm can), non-cooled, 2-lead",
    "pinCount": 2,
    "lifecycle": "active",
    "temperatureGrade": "-40..100",
    "orderingVariants": [
      { "orderCode": "G12180-010A", "package": "TO-18 (Ø9.2 mm can), non-cooled" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "Anode", "function": "ANODE", "type": "passive", "description": "Detector anode. Photocurrent sink terminal of the InGaAs PIN junction; connect to the reverse-bias return / transimpedance-amplifier input.", "sourcePage": 6 },
    { "number": 2, "name": "Cathode", "function": "CATHODE", "type": "passive", "description": "Detector cathode. Reverse-bias (V_R) is applied here positive relative to the anode; internally common to the TO-18 case.", "sourcePage": 6 }
