    { "number": 2, "name": "LD Anode", "function": "LD_ANODE", "type": "passive", "description": "Laser-diode anode (+); forward drive current flows in here. PIN 2 = LD Anode. An internal ESD-protection diode is connected across the laser junction.", "sourcePage": 9 },
    { "number": 3, "name": "Case", "function": "CASE", "type": "thermal", "description": "TO90 metal can / base plate. The laser diode is electrically isolated from the package; the base plate is the only heat-dissipation path and must be heatsunk. Not a numbered electrical pin in the datasheet.", "sourcePage": 2 }
