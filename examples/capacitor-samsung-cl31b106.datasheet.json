    "mpn": "CL31B106KBHNNNE",
    "manufacturer": "Samsung Electro-Mechanics",
    "family": "capacitor",
    "description": "10 uF / 50 V X7R Class-II multilayer ceramic chip capacitor (MLCC), 1206 (3216 metric) case, 1.6 mm thick, tolerance +/-10% (K). Non-polar. X7R temperature characteristic: capacitance change within +/-15% over -55 to +125 degC. As a Class-II (ferroelectric) dielectric, the effective capacitance derates strongly under DC bias (capacitance_vs_dc_bias) and varies with applied AC signal level (capacitance_vs_ac_signal) and temperature (capacitance_vs_temperature). RoHS/Halogen compliant, Sn termination.",
    "package": "1206 (3216 metric)",
    "pinCount": 2,
    "polarity": "bipolar",
    "lifecycle": "active",
    "temperatureGrade": "-55..125",
    "orderingVariants": [
      { "orderCode": "CL31B106KBHNNNE", "package": "1206 (3216 metric)", "packing": "Embossed tape, 7 inch reel, 2000 pcs" }
    ]
  },
