{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "DG408",
    "manufacturer": "Vishay Siliconix",
    "family": "analog_switch",
    "description": "8-channel single-ended CMOS analog multiplexer (sub_type: multiplexer, config: 8:1). Connects one of eight inputs (S1..S8) to a common output (D) as selected by a 3-bit binary address (A0, A1, A2), with an active-high enable (EN) that forces all channels off for stacking. Break-before-make switching prevents momentary crosstalk between adjacent channels; each on channel conducts equally in both directions and each off channel blocks to the supply rails. On-resistance 100 ohm max, 20 pC charge injection, 160 ns address-to-output transition. Built on the 44 V silicon-gate CMOS process with an epitaxial anti-latchup layer: operates from dual supplies (+/-5 V to +/-20 V) or a single supply (+5 V to +36 V, 44 V max V+ to V-), with TTL-compatible address and enable inputs over the full temperature range. DG408 is the single-ended 8:1 member of the DG408/DG409 family (DG409 is a dual differential 4:1). This document describes the DG408 (D suffix, -40 to +85 degC grade).",
    "package": "SOIC-16",
    "pinCount": 16,
    "polarity": "positive",
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "DG408DJ-E3", "package": "16-pin plastic DIP", "packing": "Tube, RoHS" },
      { "orderCode": "DG408DY-E3", "package": "16-pin SOIC", "packing": "Tube, RoHS" },
      { "orderCode": "DG408DY-T1-E3", "package": "16-pin SOIC", "packing": "Tape and Reel, RoHS" },
      { "orderCode": "DG408DQ-E3", "package": "16-pin TSSOP", "packing": "Tube, RoHS" },
      { "orderCode": "DG408DQ-T1-E3", "package": "16-pin TSSOP", "packing": "Tape and Reel, RoHS" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "A0", "function": "A0", "type": "digital_in", "description": "Address (select) input, bit 0. A2:A1:A0 = 000 selects S1 .. 111 selects S8 when EN = 1. TTL/CMOS compatible.", "sourcePage": 1 },
    { "number": 2, "name": "EN", "function": "EN", "type": "digital_in", "description": "Enable input. EN = 0 forces all eight channels off (D disconnected); EN = 1 enables the addressed channel. TTL/CMOS compatible; allows stacking multiple devices.", "sourcePage": 1 },
    { "number": 3, "name": "V-", "function": "VN", "type": "power", "description": "Negative analog supply rail (e.g. -15 V dual, or GND for single-supply operation).", "sourcePage": 1 },
    { "number": 4, "name": "S1", "function": "S1", "type": "analog", "description": "Channel-1 source terminal. Connected to D when A2:A1:A0 = 000 and EN = 1. Bidirectional analog signal path.", "sourcePage": 1 },
    { "number": 5, "name": "S2", "function": "S2", "type": "analog", "description": "Channel-2 source terminal. Connected to D when A2:A1:A0 = 001 and EN = 1.", "sourcePage": 1 },
    { "number": 6, "name": "S3", "function": "S3", "type": "analog", "description": "Channel-3 source terminal. Connected to D when A2:A1:A0 = 010 and EN = 1.", "sourcePage": 1 },
    { "number": 7, "name": "S4", "function": "S4", "type": "analog", "description": "Channel-4 source terminal. Connected to D when A2:A1:A0 = 011 and EN = 1.", "sourcePage": 1 },
    { "number": 8, "name": "D", "function": "D", "type": "analog", "description": "Common (drain) terminal; the multiplexer output shared by all eight channels. Bidirectional analog signal path.", "sourcePage": 1 },
    { "number": 9, "name": "S8", "function": "S8", "type": "analog", "description": "Channel-8 source terminal. Connected to D when A2:A1:A0 = 111 and EN = 1.", "sourcePage": 1 },
    { "number": 10, "name": "S7", "function": "S7", "type": "analog", "description": "Channel-7 source terminal. Connected to D when A2:A1:A0 = 110 and EN = 1.", "sourcePage": 1 },
    { "number": 11, "name": "S6", "function": "S6", "type": "analog", "description": "Channel-6 source terminal. Connected to D when A2:A1:A0 = 101 and EN = 1.", "sourcePage": 1 },
    { "number": 12, "name": "S5", "function": "S5", "type": "analog", "description": "Channel-5 source terminal. Connected to D when A2:A1:A0 = 100 and EN = 1.", "sourcePage": 1 },
    { "number": 13, "name": "V+", "function": "VP", "type": "power", "description": "Positive analog supply rail (e.g. +15 V dual, or +5 V to +36 V single).", "sourcePage": 1 },
    { "number": 14, "name": "GND", "function": "GND", "type": "power", "description": "Ground / logic reference.", "sourcePage": 1 },
    { "number": 15, "name": "A2", "function": "A2", "type": "digital_in", "description": "Address (select) input, bit 2 (most significant). TTL/CMOS compatible.", "sourcePage": 1 },
    { "number": 16, "name": "A1", "function": "A1", "type": "digital_in", "description": "Address (select) input, bit 1. TTL/CMOS compatible.", "sourcePage": 1 }
  ],
