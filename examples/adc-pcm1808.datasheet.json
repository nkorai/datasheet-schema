{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "PCM1808",
    "manufacturer": "Texas Instruments",
    "family": "adc",
    "description": "Single-ended, stereo, 24-bit, 8-96 kHz multibit delta-sigma audio analog-to-digital converter (sub_type: audio). Two single-ended analog inputs (VINL/VINR) sampled against VREF (= 0.5 VCC); 64x oversampling delta-sigma modulators feed a linear-phase decimation/digital filter. Serial audio output in I2S or left-justified format (MSB-first, 2s complement), master or slave mode. Pins: VREF (1, reference decoupling = 0.5 VCC), AGND (2), VCC (3, analog 5 V), VDD (4, digital 3.3 V), DGND (5), SCKI (6, system/master clock input 256/384/512 fS), LRCK (7, audio-data latch/word clock), BCK (8, audio-data bit clock), DOUT (9, audio-data output), MD0 (10)/MD1 (11) mode select, FMT (12) format select, VINL (13)/VINR (14) analog inputs. 14-pin TSSOP (PW).",
    "package": "TSSOP-14 (PW)",
    "pinCount": 14,
    "polarity": "positive",
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "PCM1808PW", "package": "TSSOP-14 (PW)", "packing": "Tube" },
      { "orderCode": "PCM1808PWR", "package": "TSSOP-14 (PW)", "packing": "Tape and Reel" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "VREF", "function": "VREF", "type": "analog", "description": "Reference-voltage decoupling (= 0.5 VCC). Bypass to AGND.", "sourcePage": 3 },
    { "number": 2, "name": "AGND", "function": "AGND", "type": "power", "description": "Analog ground.", "sourcePage": 3 },
    { "number": 3, "name": "VCC", "function": "AVDD", "type": "power", "description": "Analog power supply, 5 V.", "sourcePage": 3 },
    { "number": 4, "name": "VDD", "function": "DVDD", "type": "power", "description": "Digital power supply, 3.3 V.", "sourcePage": 3 },
    { "number": 5, "name": "DGND", "function": "DGND", "type": "power", "description": "Digital ground.", "sourcePage": 3 },
    { "number": 6, "name": "SCKI", "function": "MCLK", "type": "digital_in", "description": "System (master) clock input; 256 fS, 384 fS or 512 fS. Schmitt-trigger, 5-V tolerant.", "sourcePage": 3 },
    { "number": 7, "name": "LRCK", "function": "LRCK", "type": "digital_in", "description": "Audio-data latch-enable (word/LR) clock, input in slave mode or output in master mode.", "sourcePage": 3 },
    { "number": 8, "name": "BCK", "function": "BCK", "type": "digital_in", "description": "Audio-data bit clock, input in slave mode or output in master mode.", "sourcePage": 3 },
    { "number": 9, "name": "DOUT", "function": "SDOUT", "type": "digital_out", "description": "Audio-data digital output (serial).", "sourcePage": 3 },
    { "number": 10, "name": "MD0", "function": "MD0", "type": "digital_in", "description": "Audio-interface mode select 0. Schmitt-trigger, 50-kohm pulldown, 5-V tolerant.", "sourcePage": 3 },
    { "number": 11, "name": "MD1", "function": "MD1", "type": "digital_in", "description": "Audio-interface mode select 1. Schmitt-trigger, 50-kohm pulldown, 5-V tolerant.", "sourcePage": 3 },
    { "number": 12, "name": "FMT", "function": "FMT", "type": "digital_in", "description": "Audio-interface format select (I2S vs left-justified). Schmitt-trigger, 50-kohm pulldown, 5-V tolerant.", "sourcePage": 3 },
    { "number": 13, "name": "VINL", "function": "AINL", "type": "analog", "description": "Analog input, left channel (single-ended).", "sourcePage": 3 },
    { "number": 14, "name": "VINR", "function": "AINR", "type": "analog", "description": "Analog input, right channel (single-ended).", "sourcePage": 3 }
  ],
