{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "SiT8008",
    "manufacturer": "SiTime",
    "family": "oscillator",
    "description": "MEMS programmable low-power SPXO (simple packaged crystal oscillator). A silicon-MEMS resonator plus a programmable PLL and an LVCMOS/HCMOS output stage in one part; any output frequency 1 to 110 MHz set at order/field-programming time (accurate to 6 decimal places), three total-stability grades (±20 / ±25 / ±50 ppm), five supply rails (1.8 / 2.5 / 2.8 / 3.0 / 3.3 V and 2.25–3.63 V), programmable drive strength (up to 60 pF loads), and an OE or ST (standby) function on pin 1. This document captures one concrete ordered grade: 20.000000 MHz, 3.3 V rail, ±25 ppm total stability, industrial −40 to +85 °C, 3.2 x 2.5 mm (3225) 4-pin package, default drive strength, 15 pF load. Values are the 3.3 V-rail figures of the multi-rail electrical table.",
    "package": "3.2 x 2.5 x 0.75 mm (3225), 4-pin",
    "pinCount": 4,
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "SiT8008AI-33-33E-20.000000T", "package": "3.2 x 2.5 mm (3225)", "packing": "Tape and reel (representative order code for the 3.3 V / 20 MHz / ±25 ppm / industrial grade)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "OE/ST", "function": "OE", "type": "digital_in", "description": "Dual-function control input. In OE mode: H or Open = specified frequency output, L = output high-impedance (only the output driver is disabled, core keeps running -> disable_current). In ST (standby) mode: H or Open = specified frequency output, L = output weakly pulled low and the device sleeps, supply current drops to standby_current. A <10 kohm pull-up to Vdd is recommended in high-noise environments.", "sourcePage": 2 },
    { "number": 2, "name": "GND", "function": "GND", "type": "power", "description": "Electrical ground. A 0.1 uF Vdd-to-GND bypass capacitor is recommended.", "sourcePage": 2 },
    { "number": 3, "name": "OUT", "function": "OUT", "type": "digital_out", "description": "LVCMOS/HCMOS oscillator output.", "sourcePage": 2 },
    { "number": 4, "name": "VDD", "function": "VDD", "type": "power", "description": "Power supply voltage.", "sourcePage": 2 }
  ],
