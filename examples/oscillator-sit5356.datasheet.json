{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "SiT5356",
    "manufacturer": "SiTime",
    "family": "oscillator",
    "description": "MEMS Super-TCXO (Elite Platform Precision), fully compliant to Telcordia GR-1244-CORE Stratum 3. DualMEMS temperature sensing with TurboCompensation for best dynamic stability under airflow, thermal shock, vibration and EMI; on-chip regulators eliminate an external LDO. This document describes ONE ordered grade: the Stratum-3+ frequency-stability option (order code 'Q', +/-0.1 ppm / +/-100 ppb), plain TCXO configuration (pin 1 = OE, non-pullable output), 10.000000 MHz LVCMOS output, 3.3 V supply, Extended-Industrial -40 to +105 C. The SiT5356 is factory-programmable for any frequency 1-60 MHz and also ships as VCTCXO (voltage control, +/-6.25 ppm pull) and DCTCXO (I2C digital pull to 5 ppt) configurations and as +/-0.2 / +/-0.25 ppm (Stratum 3, codes P/N) grades - each a distinct orderable grade documented separately. The exemplar exercises the ppb->ppm normalization (SiTime prints ppb; 1 ppb = 1e-3 ppm), phase_noise arrayed over F_OFFSET, and allan_deviation.",
    "package": "Ceramic 5.0 x 3.2 mm, 10-pin",
    "pinCount": 10,
    "lifecycle": "active",
    "msl": "MSL1",
    "temperatureGrade": "-40..105 (Extended Industrial)",
    "orderingVariants": [
      { "orderCode": "SiT5356AC-FQ-33E0-10.000000T", "package": "Ceramic 5.0 x 3.2 mm", "packing": "12 mm Tape & Reel, 3 ku reel" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "OE", "function": "OE", "type": "digital_in", "description": "Output enable (TCXO configuration, order-code 'E'). Internal 100 kOhm pull-up to Vdd. H = specified frequency output; L = output high-impedance (only the output driver is disabled). Can be ordered as NC ('N') instead.", "sourcePage": 10 },
    { "number": 2, "name": "NC", "function": "NC", "type": "passive", "description": "No connect in TCXO configuration (SCL / I2C serial clock only in DCTCXO). Can be left floating.", "sourcePage": 10 },
    { "number": 3, "name": "NC", "function": "NC", "type": "passive", "description": "No connect. Can be left floating.", "sourcePage": 10 },
    { "number": 4, "name": "GND", "function": "GND", "type": "power", "description": "Ground.", "sourcePage": 10 },
    { "number": 5, "name": "NC", "function": "NC", "type": "passive", "description": "No connect in TCXO configuration (A0 I2C address pin only in DCTCXO). Can be left floating.", "sourcePage": 10 },
    { "number": 6, "name": "CLK", "function": "CLK", "type": "digital_out", "description": "LVCMOS (or clipped-sinewave) oscillator output.", "sourcePage": 10 },
    { "number": 7, "name": "NC", "function": "NC", "type": "passive", "description": "No connect. Can be left floating.", "sourcePage": 10 },
    { "number": 8, "name": "NC", "function": "NC", "type": "passive", "description": "No connect. Can be left floating.", "sourcePage": 10 },
    { "number": 9, "name": "VDD", "function": "VDD", "type": "power", "description": "Power supply. Requires 0.1 uF in parallel with 10 uF between VDD and GND.", "sourcePage": 10 },
    { "number": 10, "name": "NC", "function": "NC", "type": "passive", "description": "No connect in TCXO configuration (SDA I2C serial data only in DCTCXO). Can be left floating.", "sourcePage": 10 }
