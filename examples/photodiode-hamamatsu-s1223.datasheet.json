    "family": "photodiode",
    "description": "Silicon PIN photodiode for visible-to-near-IR precision photometry, in a TO-5 metal can with a borosilicate glass window. Effective photosensitive area 6.6 mm2 (2.4 x 2.8 mm active surface). Spectral response 320-1100 nm, peak sensitivity 960 nm, peak photosensitivity 0.6 A/W. Low dark current (0.1 nA typ at VR=20 V), low terminal capacitance (10 pF), and a 30 MHz cutoff frequency for high-speed response.",
    "package": "TO-5",
    "pinCount": 3,
    "lifecycle": "active",
    "temperatureGrade": "-40..100",
    "orderingVariants": [
      { "orderCode": "S1223", "package": "TO-5" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "Anode", "function": "ANODE", "type": "passive", "description": "Photodiode anode (p-side). Sources the photocurrent under reverse or photovoltaic bias.", "sourcePage": 3 },
    { "number": 2, "name": "Cathode", "function": "CATHODE", "type": "passive", "description": "Photodiode cathode (n-side). Reverse bias VR is applied here (VR max 30 V).", "sourcePage": 3 },
    { "number": 3, "name": "Case", "function": "CASE", "type": "passive", "description": "Metal TO-5 header/case. The dimensional-outline drawing marks the photosensitive-area electrode as 'Connected to case'. The datasheet does not letter the two leads (anode/cathode) nor number which lead ties to the case; the lead-to-function mapping here is nominal.", "sourcePage": 3 }
