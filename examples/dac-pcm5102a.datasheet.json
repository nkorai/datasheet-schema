{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "PCM5102A",
    "manufacturer": "Texas Instruments",
    "family": "dac",
    "description": "Stereo 32-bit, 8-384 kHz delta-sigma (advanced segment-DAC) audio digital-to-analog converter (sub_type: audio). Accepts 16-/24-/32-bit PCM audio in I2S or left-justified format over a 3-wire interface (BCK/DIN/LRCK), with an integrated audio PLL that regenerates the system clock (SCK) from BCK so no external master clock is required. Directpath charge-pump technology (CPVDD, flying-cap CAPP/CAPM, negative rail VNEG) produces ground-centered 2.1 VRMS single-ended line outputs (OUTL/OUTR) driving loads down to 1 kohm with no DC-blocking capacitors. On-chip LDO (LDOO) supplies the internal 1.8 V logic rail; single-supply 3.3 V analog (AVDD)/charge-pump (CPVDD) with 1.8 V or 3.3 V digital (DVDD). Hardware-pin configuration: FMT (I2S vs left-justified), DEMP (44.1-kHz de-emphasis), FLT (normal vs low-latency filter), XSMT (soft mute). AEC-Q100 qualified (this document describes the consumer, non-Q1 PCM5102A). Pins (PW 20): CPVDD(1), CAPP(2), CPGND(3), CAPM(4), VNEG(5), OUTL(6), OUTR(7), AVDD(8), AGND(9), DEMP(10), FLT(11), SCK(12), BCK(13), DIN(14), LRCK(15), FMT(16), XSMT(17), LDOO(18), DGND(19), DVDD(20).",
    "package": "TSSOP-20 (PW)",
    "pinCount": 20,
    "polarity": "positive",
    "lifecycle": "active",
    "temperatureGrade": "-40..130 (junction); consumer/non-Q1",
    "orderingVariants": [
      { "orderCode": "PCM5102APW", "package": "TSSOP-20 (PW)", "packing": "Tube" },
      { "orderCode": "PCM5102APWR", "package": "TSSOP-20 (PW)", "packing": "Tape and Reel" }
    ]
  },
  "pinout": [
