{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "ACNW3190-000E",
    "manufacturer": "Broadcom (Avago Technologies)",
    "family": "optocoupler",
    "description": "Reinforced-isolation gate-drive optocoupler for IGBT/MOSFET power stages. An AlGaAs LED input is optically coupled across a 60747-5-5 reinforced barrier to an integrated power output stage delivering 5.0 A peak output current, with UVLO protection and a 0.5 V maximum low-level output that eliminates the need for negative gate drive. Highest insulation voltage in the family: VIORM = 1414 Vpeak, VISO = 5000 Vrms (UL1577, 1 min). 8-pin 400 mil wide-body DIP; industrial -40 to 100 C. This document is the richest isolation-safety exemplar: it captures the full IEC/EN/DIN EN 60747-5-5 insulation block (VIORM/VPR/VIOTM, safety-limiting values, creepage/clearance/DTI/CTI).",
    "package": "DIP-8 (400 mil wide body)",
    "pinCount": 8,
    "lifecycle": "active",
    "temperatureGrade": "-40..100",
    "orderingVariants": [
      { "orderCode": "ACNW3190-000E", "package": "400 mil DIP-8", "packing": "42 per tube" },
      { "orderCode": "ACNW3190-300E", "package": "400 mil DIP-8 gull-wing surface mount", "packing": "42 per tube" },
      { "orderCode": "ACNW3190-500E", "package": "400 mil DIP-8 gull-wing surface mount", "packing": "750 per reel (tape and reel)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "N/C", "function": "NC", "type": "passive", "description": "No internal connection. Pins 1 and 4 are tied to LED common in the CMR test setup (notes 11), but carry no device function.", "sourcePage": 1 },
    { "number": 2, "name": "ANODE", "function": "ANODE", "type": "digital_in", "description": "Input LED anode. Drive current IF(ON) = 10 to 16 mA turns the output on.", "sourcePage": 1 },
    { "number": 3, "name": "CATHODE", "function": "CATHODE", "type": "digital_in", "description": "Input LED cathode.", "sourcePage": 1 },
    { "number": 4, "name": "N/C", "function": "NC", "type": "passive", "description": "No internal connection.", "sourcePage": 1 },
    { "number": 5, "name": "VEE", "function": "VEE", "type": "power", "description": "Output stage negative supply / gate-drive return. A 0.1 uF bypass capacitor must be connected between pins 5 and 8.", "sourcePage": 1 },
    { "number": 6, "name": "VO", "function": "VO", "type": "digital_out", "description": "Gate-drive output. Sources up to 5 A peak (high) and sinks up to 5 A peak (low) to the IGBT/MOSFET gate.", "sourcePage": 1 },
    { "number": 7, "name": "VCC", "function": "VCC", "type": "power", "description": "Output stage positive supply. Recommended VCC - VEE = 15 to 30 V.", "sourcePage": 1 },
    { "number": 8, "name": "VEE", "function": "VEE", "type": "power", "description": "Output stage negative supply (second VEE pin). Bypass to pin 5 with 0.1 uF.", "sourcePage": 1 }
  ],
