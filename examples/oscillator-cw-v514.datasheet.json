{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "V514",
    "manufacturer": "Connor-Winfield",
    "family": "oscillator",
    "description": "3.3 V surface-mount 5x7.5 mm LVDS VCXO (voltage-controlled crystal oscillator). Quartz resonator with an integrated sustaining/output stage driving differential LVDS outputs and an enable/disable (tri-state) function, targeted at very-high-frequency, low-jitter, low-phase-noise clocking. The V514 model family spans a 130-167 MHz center-frequency range; this document describes one ordered grade at 148.5 MHz (the datasheet's own ordering example - 'V514-148.5M'). Headline: +/-80 ppm minimum absolute pull range (APR) and +/-50 ppm frequency stability over -20 to +70 C. Hermetically sealed ceramic package with grounded metal cover; RoHS/lead-free, tape-and-reel. Sub-type VCXO, quartz technology, LVDS output.",
    "package": "5x7.5 mm ceramic surface-mount (6-pad)",
    "pinCount": 6,
    "lifecycle": "active",
    "temperatureGrade": "-20..70",
    "orderingVariants": [
      {
        "orderCode": "V514-148.5M",
        "package": "5x7.5 mm SMD",
        "packing": "Tape and reel"
      }
    ]
  },
  "pinout": [
    {
      "number": 1,
      "name": "Vc (Control Voltage)",
      "function": "VC",
      "type": "analog",
      "description": "Analog control-voltage (EFC) input. 0.3 to 3.0 V pulls the frequency about the 1.65 V nominal-center bias; positive transfer function.",
      "sourcePage": 2
    },
    {
      "number": 2,
      "name": "Enable/Disable",
      "function": "OE",
      "type": "digital_in",
      "description": "Output enable/disable. Low = Enable (active output); High or Open = Disable (both outputs high-impedance / tri-state).",
      "sourcePage": 2
    },
    {
      "number": 3,
      "name": "Ground (Case)",
      "function": "GND",
      "type": "power",
      "description": "Ground, connected to the grounded metal case/cover.",
      "sourcePage": 2
    },
    {
      "number": 4,
      "name": "Q (Output)",
      "function": "OUT",
      "type": "digital_out",
      "description": "True LVDS differential output (Q).",
      "sourcePage": 2
    },
    {
      "number": 5,
      "name": "Qbar (Comp Output)",
      "function": "OUT_N",
      "type": "digital_out",
      "description": "Complementary LVDS differential output (Q-bar).",
      "sourcePage": 2
    },
    {
      "number": 6,
      "name": "Vcc",
      "function": "VCC",
      "type": "power",
      "description": "3.3 V supply. Bypass with a >= 0.01 uF ceramic capacitor.",
      "sourcePage": 2
    }
