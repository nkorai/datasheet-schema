    "mpn": "SG3225EEN",
    "manufacturer": "Seiko Epson Corporation",
    "family": "oscillator",
    "description": "LV-PECL differential quartz crystal oscillator (SPXO) in a 3.2 x 2.5 x 1.05 mm 6-pad ceramic SMD package - the quartz counterpart to a MEMS differential clock. The SG3225EEN family spans 25 MHz to 500 MHz on a 2.5 V or 3.3 V rail with an output-enable (OE) function and 50 fs typ phase jitter at 156.25 MHz. This document captures the ordered grade SG3225EEN 156.250000M-CJGA: 156.25 MHz, 3.3 V rail (C), inclusive frequency tolerance +/-50 ppm (J), operating -40 to +85 C (G). Frequency tolerance is a single all-inclusive figure (initial + temperature + supply + long-term aging), the hallmark of a short-form clock-oscillator brief. Source is the Epson product brief; the full datasheet is available from Epson on request.",
    "package": "SG3225 ceramic SMD (3.2 x 2.5 x 1.05 mm), 6 pad",
    "pinCount": 6,
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "SG3225EEN 156.250000M-CJGA", "package": "3225 SMD (3.2 x 2.5 x 1.05 mm)", "packing": "tape and reel" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "OE", "function": "OE", "type": "digital_in", "description": "Output enable. HIGH or Open = specified frequency output; LOW = output high impedance. Internal logic thresholds VIH = 70% VCC min, VIL = 30% VCC max.", "sourcePage": 1 },
    { "number": 2, "name": "N.C.", "function": "NC", "type": "passive", "description": "No connection (leave Open or tie to VCC).", "sourcePage": 1 },
    { "number": 3, "name": "GND", "function": "GND", "type": "power", "description": "Ground.", "sourcePage": 1 },
    { "number": 4, "name": "OUT", "function": "OUT", "type": "digital_out", "description": "Non-inverting LV-PECL output. 50 ohm load terminated to VCC - 2.0 V.", "sourcePage": 1 },
    { "number": 5, "name": "OUT", "function": "OUT_N", "type": "digital_out", "description": "Inverting / complementary LV-PECL output (printed as OUT with an overbar). 50 ohm load terminated to VCC - 2.0 V.", "sourcePage": 1 },
    { "number": 6, "name": "VCC", "function": "VCC", "type": "power", "description": "Supply. Bypass 0.1 uF and 10 uF between VCC and GND, placed close to the VCC pin for optimum jitter.", "sourcePage": 1 }
