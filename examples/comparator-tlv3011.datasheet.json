{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "TLV3011",
    "manufacturer": "Texas Instruments",
    "family": "comparator",
    "description": "Nanopower (2.8 uA typ supply current) single comparator with an open-drain output and an uncommitted, brought-out 1.242 V series voltage reference (1% initial accuracy, 100 ppm/degC max drift). Input common-mode range extends 200 mV beyond both rails; single-supply operation from 1.8 V to 5.5 V. Because it is a micropower part its propagation delay is in the microsecond range (6 us at 100 mV overdrive) and collapses with overdrive. sub_type: general_purpose (low-power). output stage: open_drain (the high level is set by an external pull-up; no internal VOH). This document covers the non-B TLV3011 (A grade); the TLV3011B adds built-in hysteresis, power-on-reset, fail-safe inputs and a 1.65 V minimum supply and is a separate grade not merged here.",
    "package": "SOT-23-6",
    "pinCount": 6,
    "polarity": "positive",
    "lifecycle": "active",
    "temperatureGrade": "-40..125",
    "orderingVariants": [
      { "orderCode": "TLV3011AIDBVR", "package": "SOT-23-6 (DBV)", "packing": "Tape and Reel" },
      { "orderCode": "TLV3011AIDBVT", "package": "SOT-23-6 (DBV)", "packing": "Tape and Reel" },
      { "orderCode": "TLV3011AIDCKR", "package": "SC-70-6 (DCK)", "packing": "Tape and Reel" },
      { "orderCode": "TLV3011AIDCKT", "package": "SC-70-6 (DCK)", "packing": "Tape and Reel" }
    ]
  },
  "pinout": [
