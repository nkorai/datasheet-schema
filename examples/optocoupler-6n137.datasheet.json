{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "6N137",
    "manufacturer": "Vishay Semiconductors",
    "family": "optocoupler",
    "description": "Single-channel 10 MBd high-speed optocoupler: a high-efficiency AlGaAs input LED coupled across a galvanic-isolation barrier to a high-speed integrated photo-detector logic gate with an OPEN-DRAIN output and a strobable (active-low) enable input. LVTTL/LVCMOS compatible, 8-pin DIP. This document describes the 6N137 grade only, the 1000 V/us (1 kV/us) common-mode transient immunity grade of the shared 6N137/VO2601/VO2611 datasheet; the VO2601 (5000 V/us) and VO2611 (15 000 V/us) grades differ only in CMTI and are separate MPNs, one document per grade.",
    "package": "DIP-8",
    "pinCount": 8,
    "lifecycle": "active",
    "temperatureGrade": "-40..100",
    "orderingVariants": [
      { "orderCode": "6N137", "package": "DIP-8" },
      { "orderCode": "6N137-X006", "package": "DIP-8, 400 mil (option 6)" },
      { "orderCode": "6N137-X007T", "package": "SMD-8 (option 7)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "NC", "function": "NC", "type": "passive", "description": "No internal connection.", "sourcePage": 1 },
    { "number": 2, "name": "Anode", "function": "ANODE", "type": "passive", "description": "Input LED anode. Drive current into this pin to turn the LED on.", "sourcePage": 1 },
    { "number": 3, "name": "Cathode", "function": "CATHODE", "type": "passive", "description": "Input LED cathode.", "sourcePage": 1 },
    { "number": 4, "name": "NC", "function": "NC", "type": "passive", "description": "No internal connection.", "sourcePage": 1 },
    { "number": 5, "name": "GND", "function": "GND", "type": "power", "description": "Output-side ground.", "sourcePage": 1 },
    { "number": 6, "name": "VO", "function": "VO", "type": "digital_out", "description": "Open-drain logic output. Requires an external pull-up resistor (RL) to VCC.", "sourcePage": 1 },
    { "number": 7, "name": "VE", "function": "ENABLE", "type": "digital_in", "description": "Output enable (strobe). Logic high enables the output; if unused, connect to VCC. No external pull-up required for a high state.", "sourcePage": 1 },
    { "number": 8, "name": "VCC", "function": "VCC", "type": "power", "description": "Output-side positive supply, 4.5 V to 5.5 V recommended.", "sourcePage": 1 }
  ],
