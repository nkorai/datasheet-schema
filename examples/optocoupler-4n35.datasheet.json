{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "4N35",
    "manufacturer": "Vishay Semiconductors",
    "family": "optocoupler",
    "description": "Phototransistor-output optocoupler in a 6-pin DIP with the phototransistor BASE brought out (pin 6). A gallium-arsenide infrared LED (input, pins 1-2) is optically coupled across a galvanic-isolation barrier to a silicon NPN phototransistor (output, pins 4-5-6). CTR > 100 % grade (the 4N35 rank; the sister 4N36/4N37 are separate documents). Isolation test voltage 5000 Vrms, input-output coupling capacitance < 0.5 pF. The base-out pin is what distinguishes this part from the base-less PC817/EL817 phototransistor couplers, enabling BVCBO characterization and external base biasing.",
    "package": "DIP-6",
    "pinCount": 6,
    "lifecycle": "active",
    "temperatureGrade": "-55..100",
    "orderingVariants": [
      { "orderCode": "4N35", "package": "DIP-6", "packing": "tube" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "Anode", "function": "ANODE", "type": "passive", "description": "Input LED anode. Forward drive current IF flows in here (VF ~1.3 V at IF = 10 mA).", "sourcePage": 1 },
    { "number": 2, "name": "Cathode", "function": "CATHODE", "type": "passive", "description": "Input LED cathode. Reverse voltage across the LED must stay below VR = 6 V (abs max).", "sourcePage": 1 },
    { "number": 3, "name": "NC", "function": "NC", "type": "passive", "description": "No connection.", "sourcePage": 1 },
    { "number": 4, "name": "Emitter", "function": "EMITTER", "type": "passive", "description": "Output phototransistor emitter.", "sourcePage": 1 },
    { "number": 5, "name": "Collector", "function": "COLLECTOR", "type": "passive", "description": "Output phototransistor collector. Collector-emitter breakdown BVCEO min 30 V; abs-max VCEO 70 V.", "sourcePage": 1 },
    { "number": 6, "name": "Base", "function": "BASE", "type": "passive", "description": "Output phototransistor base, brought out on this 6-pin variant. Enables collector-base breakdown (BVCBO) characterization and optional external base biasing; leave floating for standard optocoupler operation.", "sourcePage": 1 }
  ],
