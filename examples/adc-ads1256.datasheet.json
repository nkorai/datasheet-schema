{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "ADS1256",
    "manufacturer": "Texas Instruments",
    "family": "adc",
    "description": "24-bit, 4th-order delta-sigma (sub_type delta_sigma) analog-to-digital converter with a chopper-stabilized input buffer, a flexible input multiplexer (four differential or eight single-ended inputs via AIN0-AIN7 and AINCOM), a low-noise programmable gain amplifier (PGA = 1, 2, 4, 8, 16, 32, 64), and a programmable digital filter. Output data rate 2.5 SPS to 30 kSPS. 5-V-tolerant SPI-compatible serial interface. Analog supply 5 V (AVDD/AGND), digital supply 1.8 V to 3.6 V (DVDD/DGND), external differential reference VREFP/VREFN (nominal 2.5 V). Pinout: analog inputs AIN0-AIN7 and AINCOM (internally muxed to AINP/AINN), reference VREFP/VREFN, supplies AVDD/DVDD/AGND/DGND, and serial control SCLK/DIN/DOUT/CS/DRDY (plus SYNC/PDWN, RESET, XTAL1/CLKIN, XTAL2, and GPIO D0/CLKOUT-D3). SSOP-28 package.",
    "package": "SSOP-28",
    "pinCount": 28,
    "lifecycle": "active",
    "temperatureGrade": "-40..85"
  },
