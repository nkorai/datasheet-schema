{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "TSAL6100",
    "manufacturer": "Vishay",
    "family": "led",
    "description": "High-power 940 nm infrared (IR) emitting diode in GaAlAs multi-quantum-well (MQW) technology, in a 5 mm (T-1 3/4) leaded through-hole blue-gray molded package. A radiometric IR emitter (specified in radiant intensity W/sr and radiant power W, not photometric candela/lumen - the human eye cannot see 940 nm). Narrow beam (angle of half intensity +/-10 deg), high radiant power, and high switching speed (15 ns rise/fall) suited to IR remote control, free-air transmission, optical counters, card readers, and smoke detectors. Good spectral matching with silicon photodetectors.",
    "package": "T-1 3/4 (5 mm dia.), leaded through-hole",
    "pinCount": 2,
    "lifecycle": "active",
    "temperatureGrade": "-40..85",
    "orderingVariants": [
      { "orderCode": "TSAL6100", "package": "T-1 3/4 (5 mm dia.), leaded through-hole", "packing": "Bulk (MOQ 4000 pcs, 4000 pcs/bulk)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "A", "function": "ANODE", "type": "passive", "description": "Anode (+). The longer lead; forward current flows in here toward the cathode.", "sourcePage": 4 },
    { "number": 2, "name": "C", "function": "CATHODE", "type": "passive", "description": "Cathode (-). Identified by the flat/shorter lead side of the package.", "sourcePage": 4 }
  ],
