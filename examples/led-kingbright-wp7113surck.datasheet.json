    "description": "5mm (T-1 3/4) through-hole hyper-red indicator LED, AlGaInP on GaAs substrate, water-clear (non-diffused) lens. Two-lead radial package. Peak wavelength 645 nm, dominant wavelength 630 nm, 20 degree full viewing angle. On-axis luminous intensity 3100 mcd min / 5700 mcd typ at IF = 20 mA. Visible photometric part (luminous intensity in candela); a single AlGaInP emitter die.",
    "package": "Through-hole T-1 3/4 (5mm), radial 2-lead",
    "pinCount": 2,
    "lifecycle": "active",
    "temperatureGrade": "-40..85"
  },
  "pinout": [
    { "number": 1, "name": "ANODE", "function": "ANODE", "type": "passive", "description": "Anode (+). The longer lead; connect to the more-positive rail through a current-limiting resistor.", "sourcePage": 1 },
    { "number": 2, "name": "CATHODE", "function": "CATHODE", "type": "passive", "description": "Cathode (-). The shorter lead on the flatted side of the package flange.", "sourcePage": 1 }
