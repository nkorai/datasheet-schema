{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "S5990-01",
    "manufacturer": "Hamamatsu",
    "family": "photodiode",
    "description": "2-D tetra-lateral position-sensitive detector (PSD), 4x4 mm active area, ceramic SMD. A surface-mount silicone-resin-windowed 2-D PSD with a single resistive photosensitive layer and four position electrodes (X1/X2/Y1/Y2 anodes) plus a common cathode; the light spot's (x, y) coordinate is recovered from the four electrode photocurrents. Spectral response 320-1100 nm (Si), peak 960 nm, responsivity 0.6 A/W at the peak. Position detection error +/-70 um typ, position resolution 0.7 um. Tray-packed (S5990-01); the S5990-11 sibling is the reel-packed variant.",
    "package": "Ceramic chip carrier, surface mount, 10-terminal",
    "pinCount": 10,
    "lifecycle": "active",
    "temperatureGrade": "-20..60",
    "orderingVariants": [
      { "orderCode": "S5990-01", "package": "Ceramic chip carrier, surface mount, 10-terminal", "packing": "Tray (100 pcs max./tray)" },
      { "orderCode": "S5990-11", "package": "Ceramic chip carrier, surface mount, 10-terminal", "packing": "Embossed tape and reel (1000 pcs/reel)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "Anode X1", "function": "ANODE_X1", "type": "analog", "description": "X-axis position electrode 1 (anode). One end of the resistive layer's X divider; its photocurrent IX1 enters the x = LX/2 * ((IX2+IY1)-(IX1+IY2))/(sum) position formula.", "sourcePage": 3 },
    { "number": 2, "name": "NC", "function": "NC", "type": "passive", "description": "No connection. Must be left open-circuited.", "sourcePage": 3 },
    { "number": 3, "name": "NC", "function": "NC", "type": "passive", "description": "No connection. Must be left open-circuited.", "sourcePage": 3 },
    { "number": 4, "name": "NC", "function": "NC", "type": "passive", "description": "No connection. Must be left open-circuited.", "sourcePage": 3 },
    { "number": 5, "name": "Anode Y1", "function": "ANODE_Y1", "type": "analog", "description": "Y-axis position electrode 1 (anode). One end of the resistive layer's Y divider; supplies photocurrent IY1.", "sourcePage": 3 },
    { "number": 6, "name": "Anode X2", "function": "ANODE_X2", "type": "analog", "description": "X-axis position electrode 2 (anode). Opposing end of the X divider; supplies photocurrent IX2.", "sourcePage": 3 },
    { "number": 7, "name": "NC", "function": "NC", "type": "passive", "description": "No connection. Must be left open-circuited.", "sourcePage": 3 },
    { "number": 8, "name": "Cathode", "function": "CATHODE", "type": "analog", "description": "Common cathode / back electrode. The reverse-bias (VR) return common to the whole detector; the four anode photocurrents sum through it.", "sourcePage": 3 },
    { "number": 9, "name": "NC", "function": "NC", "type": "passive", "description": "No connection. Must be left open-circuited.", "sourcePage": 3 },
    { "number": 10, "name": "Anode Y2", "function": "ANODE_Y2", "type": "analog", "description": "Y-axis position electrode 2 (anode). Opposing end of the Y divider; supplies photocurrent IY2.", "sourcePage": 3 }
  ],
