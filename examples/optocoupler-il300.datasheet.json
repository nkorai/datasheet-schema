{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "IL300",
    "manufacturer": "Vishay Semiconductors",
    "family": "optocoupler",
    "description": "Linear (servo-photodiode) optocoupler for high-linearity analog isolation. An AlGaAs infrared emitter irradiates two matched PIN photodiodes: a feedback/servo photodiode (K1) whose photocurrent IP1 is used to servo the emitter drive, and an output/forward photodiode (K2) whose photocurrent IP2 tracks the servo flux. The matched pair makes the input-output transfer gain K3 = K2/K1 near-unity (guaranteed electrical limits min 0.56 / typ 1 / max 1.65, spanning bins A through J) and highly temperature-stable (typ +/-0.005 %/degC). Couples AC and DC signals; isolation rated 4420 Vrms. 8-pin DIP (also SMD options 7/9). This document describes the base IL300 electrical table across the full K3 bin range (bins A through J); the K3-tolerance suffix variants (IL300-E/-F/-EF/-DEFG and their -X0## package options) are separate orderable grades.",
    "package": "DIP-8",
    "pinCount": 8,
    "lifecycle": "active",
    "temperatureGrade": "-55..100",
    "orderingVariants": [
      { "orderCode": "IL300", "package": "DIP-8" },
      { "orderCode": "IL300-X007T", "package": "SMD-8 (option 7)", "packing": "tape and reel" },
      { "orderCode": "IL300-X009T", "package": "SMD-8 (option 9)", "packing": "tape and reel" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "A", "function": "ANODE", "type": "passive", "description": "Input LED (AlGaAs infrared emitter) anode. Forward current IF drives the emitter.", "sourcePage": 1 },
    { "number": 2, "name": "C", "function": "CATHODE", "type": "passive", "description": "Input LED (emitter) cathode.", "sourcePage": 1 },
    { "number": 3, "name": "NC", "function": "NC", "type": "passive", "description": "No connection.", "sourcePage": 1 },
    { "number": 4, "name": "NC", "function": "NC", "type": "passive", "description": "No connection.", "sourcePage": 1 },
    { "number": 5, "name": "K2 Cathode", "function": "OUT_CATHODE", "type": "passive", "description": "Output/forward PIN photodiode (K2) cathode. Reverse-biased at Vdet; sources the output photocurrent IP2 that tracks the emitter flux.", "sourcePage": 1 },
    { "number": 6, "name": "K2 Anode", "function": "OUT_ANODE", "type": "passive", "description": "Output/forward PIN photodiode (K2) anode.", "sourcePage": 1 },
    { "number": 7, "name": "K1 Anode", "function": "SERVO_ANODE", "type": "passive", "description": "Servo/feedback PIN photodiode (K1) anode.", "sourcePage": 1 },
    { "number": 8, "name": "K1 Cathode", "function": "SERVO_CATHODE", "type": "passive", "description": "Servo/feedback PIN photodiode (K1) cathode. Reverse-biased at Vdet; sources the servo photocurrent IP1 used to close the feedback loop.", "sourcePage": 1 }
  ],
