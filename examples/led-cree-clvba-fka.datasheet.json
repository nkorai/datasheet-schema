{
  "schemaVersion": "1.0",
  "component": {
    "mpn": "CLVBA-FKA",
    "manufacturer": "Cree LED",
    "family": "led",
    "description": "PLCC4 3-in-1 RGB SMD LED, common-anode. Three independent dies in one industry-standard PLCC4 package (3.2 x 2.8 mm): an AlGaInP red die (619-624 nm), an InGaN green die (520-540 nm), and an InGaN blue die (460-480 nm). Pin 2 is the shared common anode; pins 1, 4, and 3 are the red, green, and blue cathodes respectively. High-brightness, wide viewing angle, intended for full-color video screens, decorative lighting, and indoor signage. Each per-die optical/electrical value carries a note-only EMITTER condition (red/green/blue) so a package-wide limit (junction/operating/storage temperature) is distinguishable from a per-color spec.",
    "package": "PLCC4 SMD, 3.2 x 2.8 mm",
    "pinCount": 4,
    "lifecycle": "active",
    "temperatureGrade": "-40..100",
    "msl": "MSL5a",
    "orderingVariants": [
      { "orderCode": "CLVBA-FKA-CAEDH8BBB7a363", "package": "PLCC4 SMD, 3.2 x 2.8 mm", "packing": "Tape & Reel (max 2000 pcs/reel)" },
      { "orderCode": "CLVBA-FKA-CA1D181BB7D3D3", "package": "PLCC4 SMD, 3.2 x 2.8 mm", "packing": "Tape & Reel (max 2000 pcs/reel)" },
      { "orderCode": "CLVBA-FKA-CC1F1L1BB7D3D3", "package": "PLCC4 SMD, 3.2 x 2.8 mm", "packing": "Tape & Reel (max 2000 pcs/reel)" }
    ]
  },
  "pinout": [
    { "number": 1, "name": "R", "function": "CATHODE_R", "type": "passive", "description": "Red die cathode (AlGaInP). Drive current returns through this pin; anode is the shared pin 2. Pin-mark corner.", "sourcePage": 7 },
    { "number": 2, "name": "COM", "function": "COMMON", "type": "passive", "description": "Common anode. Shared anode for all three dies (red/green/blue); this is a common-anode part.", "sourcePage": 7 },
    { "number": 3, "name": "B", "function": "CATHODE_B", "type": "passive", "description": "Blue die cathode (InGaN).", "sourcePage": 7 },
